# This is a client-side-routed React app (react-router-dom) — Apache has
# no idea routes like /about or /join exist as anything but index.html
# with JS that reads the URL. Without this, a direct visit or a page
# refresh on any route but "/" 404s. Rewrite everything that isn't a
# real file/directory back to index.html and let the app's router do
# the rest.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Fallback for hosts where mod_rewrite isn't enabled (this appears to be
# the case on OCF's group vhosts — the block above goes silently inert
# and direct/refreshed visits to any non-root route just 404). Apache's
# ErrorDocument directive needs no extra module, so this still routes a
# 404 to index.html and lets the React router take over from there.
ErrorDocument 404 /index.html
